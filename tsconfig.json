{
    "compilerOptions": {
        "module": "commonjs", // Use commonjs for Node.js environments
        "target": "es6",     // ES6 is generally sufficient and widely supported
        "lib": [
            "es6"            // Include ES6 standard library features
        ],
        "sourceMap": true,   // Generate source maps for easier debugging
        "rootDir": "src",    // Source files are in the 'src' directory
        "outDir": "out",     // <--- THIS IS THE CRUCIAL LINE for the 'out' directory
        "strict": true,      // Enable all strict type-checking options
        "noImplicitAny": true, // Disallow 'any' types that are not explicitly typed
        "esModuleInterop": true, // Enables better interoperability with CommonJS modules
        "resolveJsonModule": true // Allows importing .json files as modules
    },
    "exclude": [ // Folders to exclude from compilation
        "node_modules",
        ".vscode-test"
    ]
}
